# Node dependencies and build output (package-lock.json remains versioned)
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata and Office lock files (after the Excel template exception)
